#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [[ -n "$1" && "$1" != '--'* ]]; then
  URL="$1"
  shift
elif [[ -f .castiron.stats.yml && -f api_reference/openapi.transformed.yml ]]; then
  URL="api_reference/openapi.transformed.yml"
  EXPECTED_HASH="$(awk '$1 == "openapi_transformed_spec_hash:" { print $2; exit }' .castiron.stats.yml)"
  ACTUAL_HASH="$(node -e 'process.stdout.write(require("node:crypto").createHash("md5").update(require("node:fs").readFileSync(process.argv[1])).digest("hex"))' "$URL")"

  if [[ -z "$EXPECTED_HASH" || "$ACTUAL_HASH" != "$EXPECTED_HASH" ]]; then
    echo "Error: Local OpenAPI specification does not match generation metadata" >&2
    exit 1
  fi
else
  echo "Error: No OpenAPI spec path/url provided and local Castiron generation metadata is unavailable" >&2
  exit 1
fi

echo "==> Starting mock server with URL ${URL}"

# Preserve npm's effective configuration while installing outside the checkout.
NPM_GLOBAL_CONFIG="$(npm config get globalconfig)"
REPOSITORY_DIRECTORY="$(pwd -P)"
TEMP_DIRECTORY="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
if [[ "$TEMP_DIRECTORY" == "$REPOSITORY_DIRECTORY" || "$TEMP_DIRECTORY" == "$REPOSITORY_DIRECTORY/"* ]]; then
  echo "Error: npm installation temporary directory must be outside the checkout" >&2
  exit 1
fi
INSTALL_DIRECTORY="$(mktemp -d "$TEMP_DIRECTORY/openai-cli-mock.XXXXXXXX")"
trap 'rm -rf "$INSTALL_DIRECTORY"' EXIT
cp scripts/mock-tools/package.json scripts/mock-tools/package-lock.json "$INSTALL_DIRECTORY/"
if [[ -f .npmrc ]]; then
  cp .npmrc "$INSTALL_DIRECTORY/.npmrc"
fi

npm ci --global=false --globalconfig "$NPM_GLOBAL_CONFIG" --prefix "$INSTALL_DIRECTORY" --package-lock=true --include=dev --include=optional \
  --ignore-scripts --no-audit --no-fund
rm -f "$INSTALL_DIRECTORY/.npmrc"
node scripts/mock-tools/resolve-native.js "$INSTALL_DIRECTORY" >/dev/null

rm -rf scripts/mock-tools/node_modules
mv "$INSTALL_DIRECTORY/node_modules" scripts/mock-tools/node_modules
STEADY="$(node scripts/mock-tools/resolve-native.js)"

STEADY_ARGS=(
  --host 127.0.0.1
  -p 4010
  --validator-query-array-format=brackets
  --validator-form-array-format=brackets
  --validator-query-object-format=brackets
  --validator-form-object-format=brackets
  "$URL"
)

# Run steady mock on the given spec.
if [ "$1" == "--daemon" ]; then
  "$STEADY" "${STEADY_ARGS[@]}" &> .stdy.log &

  # Wait for server to come online via health endpoint (max 30s)
  echo -n "Waiting for server"
  attempts=0
  while ! curl --silent --fail "http://127.0.0.1:4010/_x-steady/health" >/dev/null 2>&1; do
    if ! kill -0 $! 2>/dev/null; then
      echo
      cat .stdy.log
      exit 1
    fi
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 300 ]; then
      echo
      echo "Timed out waiting for Steady server to start"
      cat .stdy.log
      exit 1
    fi
    echo -n "."
    sleep 0.1
  done

  echo
else
  "$STEADY" "${STEADY_ARGS[@]}"
fi
