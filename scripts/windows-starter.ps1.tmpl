& {
    $ErrorActionPreference = 'Stop'
    $tag = '__STABLE_TAG__'
    $pins = @{amd64='__AMD64_SHA256__'; arm64='__ARM64_SHA256__'; '386'='__386_SHA256__'}
    $cpu = (Get-CimInstance Win32_Processor | Select-Object -First 1).Architecture
    $arch = switch ($cpu) { 0 {'386'} 9 {if ([Environment]::Is64BitOperatingSystem) {'amd64'} else {'386'}} 12 {if (![Environment]::Is64BitOperatingSystem) {throw 'Unsupported Windows processor.'}; 'arm64'} default {throw 'Unsupported Windows processor.'} }
    if ($tag -cnotmatch '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' -or $pins[$arch] -cnotmatch '^[0-9a-f]{64}$') { throw 'This starter requires published release pins.' }
    $user = [Security.Principal.WindowsIdentity]::GetCurrent()
    if ($user.User.Value -in 'S-1-5-18','S-1-5-19','S-1-5-20' -or ([Security.Principal.WindowsPrincipal]$user).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Use an ordinary PowerShell window.' }
    $base = [Environment]::GetFolderPath('LocalApplicationData')
    if (!$base -or [IO.DriveInfo]::new([IO.Path]::GetPathRoot($base)).DriveType -ne 'Fixed') {throw 'A local Windows profile is required.'}
    $sid = $user.User.Value
    $trusted = @($sid,'S-1-5-18','S-1-5-32-544','S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464')
    for ($p=[IO.DirectoryInfo]::new($base); $p; $p=$p.Parent) {
        $acl = Get-Acl -LiteralPath $p.FullName
        $raw = [Security.AccessControl.RawSecurityDescriptor]::new($acl.GetSecurityDescriptorBinaryForm(),0)
        if (($p.Attributes -band 1024) -or $null -eq $raw.DiscretionaryAcl -or $acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $trusted) {throw 'Unsafe Windows application directory.'}
        foreach ($r in $acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])) {
            if ($r.AccessControlType -eq 'Allow' -and !($r.PropagationFlags -band 2) -and $r.IdentityReference.Value -notin $trusted -and ([long]$r.FileSystemRights -band 0x500D0150)) {throw 'Unsafe Windows application directory.'}
        }
    }
    $d = [IO.DirectoryInfo]::new((Join-Path $base ('OpenAI-Setup-'+[guid]::NewGuid())))
    $security = [Security.AccessControl.DirectorySecurity]::new()
    $security.SetSecurityDescriptorSddlForm("D:P(A;OICI;FA;;;$sid)(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)")
    if ($d.Exists) {throw 'Setup directory already exists.'}
    if ($PSVersionTable.PSVersion.Major -le 5) {$d.Create($security)} else {[IO.FileSystemAclExtensions]::Create($d,$security)}
    $created = Get-Acl -LiteralPath $d.FullName
    $rules=@($created.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier]))
    if (($rules.Count -ne 3) -or ($d.Attributes -band 1024) -or !$created.AreAccessRulesProtected -or $created.GetOwner([Security.Principal.SecurityIdentifier]).Value -ne $sid) {throw 'Private staging failed.'}
    foreach ($r in $rules) {
        if ($r.AccessControlType -ne 'Allow' -or $r.IdentityReference.Value -notin @($sid,'S-1-5-18','S-1-5-32-544')) {throw 'Private staging failed.'}
    }
    try {
        $url = "https://github.com/openai/openai-cli/releases/download/$tag/openai_$($tag.Substring(1))_windows_$arch.zip"
        [Console]::Error.WriteLine("Downloading OpenAI CLI $tag for Windows $arch...")
        Add-Type -AssemblyName System.Net.Http
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        function Get-StarterBytes([string]$url) {
            $client = [Net.Http.HttpClient]::new()
            try { $client.MaxResponseContentBufferSize=128MB; return ,$client.GetByteArrayAsync($url).GetAwaiter().GetResult() } finally { $client.Dispose() }
        }
        $bytes = Get-StarterBytes $url
        $sha = [Security.Cryptography.SHA256]::Create()
        try {$hash = [BitConverter]::ToString($sha.ComputeHash($bytes)).Replace('-','')} finally {$sha.Dispose()}
        if ($hash -ine $pins[$arch]) {throw 'The published Windows ZIP checksum did not match.'}
        $exe = Join-Path $d.FullName 'openai.exe'
        $stream = [IO.MemoryStream]::new($bytes,$false)
        $zip = [IO.Compression.ZipArchive]::new($stream,'Read')
        try {[IO.Compression.ZipFileExtensions]::ExtractToFile($zip.GetEntry('openai.exe'),$exe)} finally {$zip.Dispose();$stream.Dispose()}
        [IO.File]::WriteAllText($exe+':Zone.Identifier',"[ZoneTransfer]`r`nZoneId=3`r`n",[Text.Encoding]::ASCII)
        $null = & $exe install --user
        if ($LASTEXITCODE -ne 0) {throw 'Windows enrollment failed. See the installer diagnostic.'}
        $bin = Join-Path $base 'OpenAI\CLI\bin'
        if (($env:Path -split ';',2)[0] -ine $bin) {$env:Path="$bin;$env:Path"}
        $current=Microsoft.PowerShell.Core\Get-Command openai
        if ($current.CommandType -ne 'Application' -or $current.Path -ine (Join-Path $bin 'openai.exe')) {throw 'Another command overrides openai. Use & (Join-Path $env:LOCALAPPDATA ''OpenAI\CLI\bin\openai.exe'').'}
        openai --version
    } finally {[IO.Directory]::Delete($d.FullName,$true)}
}
