#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

if [ -f "Brewfile" ] && [ "$(uname -s)" = "Darwin" ] && [ "${SKIP_BREW:-}" != "1" ] && [ -t 0 ]; then
  brew bundle check >/dev/null 2>&1 || {
    echo -n "==> Install Homebrew dependencies? (y/N): "
    read -r response
    case "$response" in
      [yY][eE][sS]|[yY])
        brew bundle
        ;;
      *)
        ;;
    esac
    echo
  }
fi
echo "==> Checking Go dependency manifests…"
go mod tidy -diff

echo "==> Downloading Go dependencies…"
go mod download

echo "==> Verifying Go dependencies…"
go mod verify
